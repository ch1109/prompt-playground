{
  "renderer_id": "jiuli-p1-v3",
  "renderer_config_version": "1.0.0",
  "adapter_id": "jiuli-p1-v3",
  "supported_prompt_kinds": ["JIULI_P1"],
  "layout": "wide-table-with-issues",
  "regions": [
    { "id": "summary", "component": "summary-strip", "binding": "metadata.summary" },
    { "id": "order-table", "component": "data-table", "binding": "tables.orderRows", "options": { "frozenColumns": ["row_no", "model"], "fieldPreset": "core" } },
    { "id": "problems", "component": "issue-list", "binding": "issues", "options": { "defaultVisible": true } },
    { "id": "scopes", "component": "data-table", "binding": "tables.scopeRecords" },
    { "id": "unlinked", "component": "data-table", "binding": "tables.unlinkedRecords" },
    { "id": "read-status", "component": "data-table", "binding": "tables.readStatus" },
    { "id": "evidence", "component": "evidence-viewer", "binding": "evidence", "mode": "drawer" }
  ]
}
