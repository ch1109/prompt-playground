{
  "renderer_id": "jiuli-p4-v15",
  "renderer_config_version": "1.0.0",
  "adapter_id": "jiuli-p4-v15",
  "supported_prompt_kinds": ["JIULI_P4"],
  "layout": "field-decisions-and-patch",
  "regions": [
    { "id": "summary", "component": "summary-strip", "binding": "metadata.summary" },
    { "id": "decisions", "component": "data-table", "binding": "tables.fieldDecisions", "options": { "filterPresets": ["all", "changes", "risks"] } },
    { "id": "totals", "component": "data-table", "binding": "tables.totUpdates" },
    { "id": "suggestions", "component": "data-table", "binding": "tables.suggestions" },
    { "id": "issues", "component": "issue-list", "binding": "issues" },
    { "id": "evidence", "component": "evidence-viewer", "binding": "evidence", "mode": "drawer" }
  ]
}
