{
  "renderer_id": "jiuli-p2",
  "renderer_config_version": "1.0.0",
  "adapter_id": "jiuli-p2-v2",
  "supported_prompt_kinds": ["JIULI_P2"],
  "layout": "hierarchy-with-issues",
  "regions": [
    { "id": "warehouses", "component": "data-table", "binding": "tables.logicalInspections", "options": { "groupBy": "warehouse_no", "expandTo": "mergedProducts" } },
    { "id": "raw-rows", "component": "data-table", "binding": "tables.inspectionRawRows", "options": { "showWhenSelected": true } },
    { "id": "precheck", "component": "issue-list", "binding": "issues" },
    { "id": "evidence", "component": "evidence-viewer", "binding": "evidence", "mode": "drawer" }
  ]
}
