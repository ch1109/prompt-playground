# 模型（OpenAI 兼容 /chat/completions）。只在服务端使用，不会发到浏览器。
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen3.6-flash
MODEL_API_KEY=
MODEL_TIMEOUT_MS=120000

# 九立 Demo 只读数据目录（九立demo 仓库根目录）。留空 = 只用 Studio 自带 Fixture。
JIULI_DEMO_ROOT=/Users/chch/Desktop/九立demo
# 当前操作者可访问的客户 ID（逗号分隔；* 表示全部）。服务端据此拒绝跨客户读取。
JIULI_ALLOWED_CUSTOMERS=*

# 真实九立只读 HTTP 接口（目前不存在，保持为空即显示"未接通"）
JIULI_API_BASE_URL=
JIULI_API_TOKEN=
